---
// CitySmash, the landing page. The hero is the game itself: the ape on the autopilot, climbing and
// smashing Port Lumen; reduced motion shows a still poster that links to /play/.
import Base from '../layouts/Base.astro';
import { base, GZIP, FIZLET, REPO } from '../site';
import { CITIES } from '../../../src/cities.ts';
import { REACH, NR, GRAB, NG, GRAB_HELI, NGH } from '../../../src/round.ts';
const description = 'CitySmash: a giant cyber ape climbs and smashes his way across seven tabletop cities, day into night. Dress him in the garage, fight three rival giants, play with friends on one screen or online. Free in the browser, by Chris Cooley, built on Fizlet.';
const kb = (GZIP / 1024).toFixed(1);
const steps = [
  ['JUMP AT A WALL', 'Walk the street and jump at a building’s side: the jump grabs it. Hang on, climb up and down the edge. Your inside arm grips; your outside arm is free to smash.'],
  ['TAP TO SMASH', 'Tap or click the window you want: in reach, he punches it. Long arms: three windows in on your floor, two on the floors above and below. Three hits a window: a chip, a crack, a hole. The far side is out of reach: climb the other edge.'],
  ['TAP TO GRAB', 'Tap someone at a window, a soldier, a parachute or food close by: he grabs it and eats. Swat a helicopter right next to him. Out of reach, he swings at air. Live boxes and neon signs bite: pick the windows round them.'],
  ['CITY AFTER CITY', 'Enough holes and a building shakes, then pancakes floor by floor. Flatten them all and the next city opens, later in the day and angrier: more soldiers, armour on the tanks, faster helicopters.'],
];
const TOD = ['Day', 'Dusk', 'Night'];
const mons = [
  ['THE APE', 'Yours to dress', 'A giant cyber ape: fur, pattern, face, a cyber arm and more gear, a neon trim of your pick.', '#c4552e', '#22e6ff'],
  ['SHARDCLAW', 'A crystal crab-beast', 'A low shell of glowing crystals, six legs and two big claws. It steals your snacks.', '#3d3378', '#7cf6ff'],
  ['GLOOPMAW', 'A tentacle blob', 'A dome of goo on tentacles, one eye, a wide mouth. It punches you off walls.', '#b23a9e', '#b6ff3a'],
  ['VOLTWING', 'A storm moth', 'Big crackling wings, feathered antennae, a bad attitude. Out from the fourth city on.', '#4a5f8c', '#fff36b'],
];
// The reach diagram, from the game's own tables (src/round.ts REACH, GRAB, GRAB_HELI): six windows across
// (two of open air and the ape's own column, then three of its building), five floors; the ape in the middle.
const COLS = 6, ROWS = 5, APE_C = 2, APE_R = 2;
const has = (t: number[], n: number, a: number, b: number, swap = false) => { for (let k = 0; k < n; k++) if ((swap ? t[k * 2 + 1] : t[k * 2]) === a && (swap ? t[k * 2] : t[k * 2 + 1]) === b) return true; return false; };
const PUNCH_WORD: Record<string, string> = { '0,1': 'close', '0,2': 'mid', '0,3': 'far', '1,1': 'up', '1,2': 'up', '-1,1': 'down', '-1,2': 'down' };
const grid = (kind: 'punch' | 'grab') => {
  const cells: { cls: string; label: string }[] = [];
  for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) {
    const inw = c - APE_C, up = APE_R - r, bld = inw > 0;
    if (inw === 0 && up === 0) { cells.push({ cls: 'ape', label: 'APE' }); continue; }
    if (kind === 'punch' && has(REACH, NR, up, inw)) cells.push({ cls: 'punch', label: PUNCH_WORD[up + ',' + inw]! });
    else if (kind === 'grab' && has(GRAB_HELI, NGH, inw, up)) cells.push({ cls: 'heli', label: '+heli' });
    else if (kind === 'grab' && has(GRAB, NG, inw, up)) cells.push({ cls: 'grab', label: 'grab' });
    else cells.push({ cls: bld ? 'bld' : 'air', label: '' });
  }
  return cells;
};
const punchCells = grid('punch'), grabCells = grid('grab');
const bricks = ['kernel', 'diorama', 'fx', 'input', 'pad', 'sound', 'touch', 'presence', 'ui'];
---
<Base title="CitySmash · climb it, smash it" description={description}>
  <section class="dt-hero" aria-labelledby="dt-title">
    <div class="dt-stage" id="dt-hero" aria-label="CitySmash demo: the ape smashing Port Lumen"></div>
    <a class="dt-poster" href={base('play/')} hidden><img src={base('shots/hero.jpg')} alt="CitySmash: a giant orange cyber ape hanging on a building's side, punching out its windows" width="1600" height="900" /></a>
    <div class="wrap dt-copy">
      <p class="eyebrow"><span class="dot"></span> A DOM VIRUS GAME · BY CHRIS COOLEY</p>
      <h1 id="dt-title">CitySmash.<br /><em>Climb it. Smash it. Eat the snacks.</em></h1>
      <p class="lead">You are a giant cyber ape. Seven tabletop cities, day into night. Hang on the walls, punch out the windows, bring the buildings down floor by floor. Then do it again with friends.</p>
      <div class="dt-ctas">
        <a class="bui-key bui-sticker-key bui-call start-key" href={base('play/')}><b>PLAY</b><span>free · in your browser</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <p class="eyebrow"><span class="index">01</span> HOW TO PLAY</p>
      <h2>Grip with one arm. Smash with the other.</h2>
      <ol class="cards">
        {steps.map(([k, b], i) => <li class="panel"><span class="n">0{i + 1}</span><h3>{k}</h3><p>{b}</p></li>)}
      </ol>
      <div class="reach" id="reach">
        <figure class="reach-fig">
          <figcaption><b>PUNCH: {NR} windows</b> on the building he holds</figcaption>
          <div class="reach-grid" role="img" aria-label={`Punch reach: ${NR} windows of his own building: close, mid and far on his floor, two up and two down.`}>
            {punchCells.map((x) => <span class={'rc ' + x.cls} data-cell={x.cls}>{x.label}</span>)}
          </div>
        </figure>
        <figure class="reach-fig">
          <figcaption><b>GRAB: {NG} spaces</b> all round him</figcaption>
          <div class="reach-grid" role="img" aria-label={`Grab reach: ${NG} spaces. The ${NGH} round him (helicopters too) and two out straight up, down, in and out (people, soldiers, food).`}>
            {grabCells.map((x) => <span class={'rc ' + x.cls} data-cell={x.cls}>{x.label}</span>)}
          </div>
        </figure>
        <ul class="reach-key">
          <li><span class="rc ape" aria-hidden="true"></span> the ape on the building's edge</li>
          <li><span class="rc bld" aria-hidden="true"></span> building</li>
          <li><span class="rc air" aria-hidden="true"></span> open air</li>
          <li><span class="rc punch" aria-hidden="true"></span> punch: his own building only</li>
          <li><span class="rc grab" aria-hidden="true"></span> grab: people, soldiers, food</li>
          <li><span class="rc heli" aria-hidden="true"></span> grab, and swat helicopters (next to him)</li>
        </ul>
      </div>
      <p class="soon">Phone: the stick moves and climbs, JUMP jumps, tap what you want smashed or eaten. Computer: A/D walk, W/S climb, Space or K jumps, click to smash or grab, M mutes. No mouse or a gamepad: J punches (W or S held: up or down), a flick of the stick in or out steps the punch close, mid, far; L grabs the nearest snack.</p>
    </div>
  </section>

  <section class="section" id="cities">
    <div class="wrap">
      <p class="eyebrow"><span class="index">02</span> THE CITIES</p>
      <h2>Seven cities, each with a trick.</h2>
      <ol class="modes cities">
        {CITIES.map((c, i) => (
          <li class="panel">
            <span class="sky" style={`--s0:${c.sky};--s1:${c.walls[1]};--m:${c.mark}`} aria-hidden="true">{c.b.map(([w, f], b) => <i class={b === c.landmark ? 'mark' : ''} style={`height:${Math.round(f * 9)}%;flex:${w};--w:${c.walls[b % 5]}`}></i>)}</span>
            <p class="meta">{i + 1} · {TOD[c.tod]} · {c.featureName}</p>
            <h3>{c.name}</h3>
            <p>{c.blurb}</p>
            <p>{c.featureText}</p>
            <p class="meta">Landmark: {c.landmarkName}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="garage">
    <div class="wrap">
      <p class="eyebrow"><span class="index">03</span> THE GARAGE</p>
      <h2>Dress your ape. Earn the rest.</h2>
      <ul class="cards">
        <li class="panel"><h3>Fur and pattern</h3><p>Twelve fur colours; plain, stripes, patches, spots or a glowing circuit.</p></li>
        <li class="panel"><h3>Face</h3><p>A heavy brow, a crest, tusks, horns or a shaggy mane. Your ape's name comes from its fur and its face.</p></li>
        <li class="panel"><h3>Gear</h3><p>A cyber arm on the smashing arm, a visor, a chest plate, tail spikes, shoulder pads, a back reactor, knuckle spikes, a jaw guard. Eight neon trims.</p></li>
        <li class="panel"><h3>Unlocks and saves</h3><p>Every city you flatten unlocks new parts. One profile on this device, plus a save code to carry it to another.</p></li>
      </ul>
    </div>
  </section>

  <section class="section" id="monsters">
    <div class="wrap">
      <p class="eyebrow"><span class="index">04</span> THE MONSTERS</p>
      <h2>One ape. Three rivals.</h2>
      <ul class="modes mons">
        {mons.map(([n, w, b, a, c]) => <li class="panel"><span class="swatch" style={`--a:${a};--b:${c}`} aria-hidden="true"></span><p class="meta">{w}</p><h3>{n}</h3><p>{b}</p></li>)}
      </ul>
      <p class="soon">The army fights back: soldiers on the street, snipers in the windows, helicopters, tanks, a gunboat. Out of health, a monster shrinks to a tiny figure and runs off the table.</p>
    </div>
  </section>

  <section class="section" id="online">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><span class="index">05</span> PLAY TOGETHER</p>
        <h2>Up to four, one screen or online.</h2>
        <p>On one screen: player one on WASD, player two on the arrows, three and four on gamepads. Online: the host opens a room and sends the link; up to three friends drop in on their own phones or computers. The host is the ape, the others take the rivals. A shared score, and one score each. You can still punch each other off the walls.</p>
        <p>Online play needs an invite code.</p>
      </div>
      <div class="panel lit">
        <h3>Same run on every screen</h3>
        <p>Only the buttons travel. Every screen runs the same city frame for frame, and your own monster answers at once: if a friend's input arrives late, the game quietly rewinds a few frames and runs them again.</p>
      </div>
    </div>
  </section>

  <section class="section" id="fizlet">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><span class="index">06</span> BUILT ON FIZLET</p>
        <h2>No libraries. {kb} KB.</h2>
        <p>CitySmash is built on <a href="https://fizlet.com/">Fizlet</a>, the micro animation and game engine for the DOM, and nothing else: no framework, no 3D library, no images in the game. The cities, the giants and the army are drawn by Fizlet's bricks on one canvas.</p>
        <p>The whole game, its Fizlet bricks and its Board UI styles: <b>{GZIP.toLocaleString('en-US')} bytes gzip</b> (measured at build, Fizlet {FIZLET}).</p>
        <ul class="bricks">{bricks.map((b) => <li><code>@fzlt/core/{b}</code></li>)}</ul>
      </div>
      <div class="panel lit by">
        <p class="eyebrow"><b>BY CHRIS COOLEY</b></p>
        <h3>It started as a tiny daily.</h3>
        <p>CitySmash grew out of a piece in Fizlet's Daily: one ape, one city block. It kept the climb and the punch, and got seven cities, a garage and friends.</p>
        <p><a href="https://coded.design/">coded.design</a> · <a href={REPO}>Source on GitHub (MIT)</a></p>
        <a class="bui-key bui-arcade bui-go" href={base('play/')}>▶ Play CitySmash</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createCitySmash } from "../../../dist/citysmash.mjs";
  const host = document.getElementById("dt-hero")!;
  const poster = document.querySelector<HTMLElement>(".dt-poster")!;
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) poster.hidden = false;
  else (window as unknown as { hero: unknown }).hero = createCitySmash({ host, attract: true, sound: false });
</script>
