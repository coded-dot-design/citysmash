---
// CitySmash, the landing page. The hero is the game itself: the ape on the autopilot, climbing and
// smashing Port Lumen; reduced motion shows a still poster that links to /play/.
import Base from '../layouts/Base.astro';
import { base, GZIP, FIZLET, REPO } from '../site';
import { CITIES } from '../../../src/cities.ts';
import { REACH, NR, GRAB, GRAB_WALL, NGW, NG, GRAB_HELI, NGH, COMBO } from '../../../src/round.ts';
const description = 'CitySmash: a giant cyber ape climbs and smashes his way across seven tabletop cities, day into night. Dress him in the garage, beat three rival giants to play them, play with friends online. Free in the browser, by Chris Cooley, built on Fizlet.';
const kb = (GZIP / 1024).toFixed(1);
const steps = [
  ['JUMP AT A WALL', 'Walk the street and jump at a building’s side: the jump grabs it. He climbs the side wall, set back from the front, so every window in reach stays in view. Your inside arm grips; your outside arm reaches round the corner to smash.'],
  ['TAP TO SMASH', `Tap or click the window you want: in reach, it lights green and he punches it. Long arms: three windows in on your floor, two on the floors above and below. Three hits a window: a chip, a crack, a hole. Out of reach it flashes red: TOO FAR. Quick, accurate taps chain a combo (up to ×${COMBO[COMBO.length - 1]}): he punches faster; a miss or a pause drops it.`],
  ['TAP TO GRAB', 'He grabs with the hand on the side he faces: in front of him, above and below it, never behind him or under his own body. Tap someone at a window (it lights teal at once): his arm reaches to them, lifts them to his mouth, NOM! and the points pop up. Tap someone behind him on the street and he turns round first, then grabs. On a wall: if he can punch a window he can grab what’s in it, plus the windows two up and down and the air over his head and under his feet. Hover (or tap) to see his grab reach. Out of reach: TOO FAR, and an arrow says where to go. Live boxes and neon signs bite: pick the windows round them.'],
  ['LEAP, LET GO', 'On a wall, jump once and he leaps across the gap to the next building and hangs on its near wall; nothing in reach and he drops to the street. Jump twice quickly and he lets go: straight down to the street.'],
  ['KEYS ONLY', 'No mouse needed: WASD or the arrows move and climb, Space jumps, J punches, K grabs. On a wall an aim sits on one window in reach: Q and E (or Tab) move it, J smashes it, K eats whoever is at it. Mix in the mouse whenever you like: a click moves the aim too.'],
  ['FIGHT THEM', 'Tap a rival monster in reach and he throws a POWER PUNCH: a long wind-up, then BOOM, it is knocked back, and off its wall if it hangs on one. Jump onto one and you POUNCE: it is stunned (stars) and your next power punch is a combo for extra. Tanks, soldiers and trucks on the street are tap targets too: tap a tank in front of you (even right at your feet) and he smashes down on it, two hits (three for armoured ones) and KRUNCH; or jump on it. Rivals fight back with the same moves: watch their wind-up and crouch, and step or jump clear. A small bar over a rival shows its health; knock one out and it shrinks and runs off (beat it in one player and it is yours to play).'],
  ['CITY AFTER CITY', 'Enough holes and a building shakes, then pancakes floor by floor. Flatten them all and the next city opens, later in the day and angrier: more soldiers, armour on the tanks, faster helicopters.'],
];
const TOD = ['Day', 'Dusk', 'Night'];
// [name, what, blurb, its kind in the game (src/round.ts HERO, CRAB, BLOB, MOTH): the turntable draws that rig].
const mons = [
  ['THE APE', 'Yours to dress', 'A giant cyber ape: fur, pattern, face, a cyber arm and more gear, a neon trim of your pick.', 0, 'a giant cyber ape'],
  ['SHARDCLAW', 'A crystal crab-beast', 'A low shell of glowing crystals, six legs and two big claws. It steals your snacks.', 1, 'a crystal crab-beast'],
  ['GLOOPMAW', 'A tentacle blob', 'A dome of goo on tentacles, one eye, a wide mouth. It punches you off walls.', 2, 'a tentacle blob'],
  ['VOLTWING', 'A storm moth', 'Big crackling wings, feathered antennae, a bad attitude. Out from the fifth city on.', 3, 'a storm moth'],
] as const;
// The reach diagram, from the game's own tables (src/round.ts REACH, GRAB_WALL, GRAB_HELI): six windows across
// (two of open air and the ape's own column, then three of its building), five floors; the ape in the middle.
const COLS = 6, ROWS = 7, APE_C = 2, APE_R = 3;
const has = (t: number[], n: number, a: number, b: number, swap = false) => { for (let k = 0; k < n; k++) if ((swap ? t[k * 2 + 1] : t[k * 2]) === a && (swap ? t[k * 2] : t[k * 2 + 1]) === b) return true; return false; };
const PUNCH_WORD: Record<string, string> = { '0,1': 'close', '0,2': 'mid', '0,3': 'far', '1,1': 'up', '1,2': 'up', '-1,1': 'down', '-1,2': 'down' };
const grid = (kind: 'punch' | 'grab') => {
  const cells: { cls: string; label: string }[] = [];
  for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) {
    const inw = c - APE_C, up = APE_R - r, bld = inw > 0;
    if (inw === 0 && up === 0) { cells.push({ cls: 'ape', label: 'APE' }); continue; }
    if (kind === 'punch' && has(REACH, NR, up, inw)) cells.push({ cls: 'punch', label: PUNCH_WORD[up + ',' + inw]! });
    else if (kind === 'grab' && has(GRAB_HELI, NGH, inw, up)) cells.push({ cls: 'heli', label: '+heli' });
    else if (kind === 'grab' && has(GRAB_WALL, NGW, inw, up)) cells.push({ cls: 'grab', label: 'grab' });
    else cells.push({ cls: bld ? 'bld' : 'air', label: '' });
  }
  return cells;
};
const punchCells = grid('punch'), grabCells = grid('grab');
// On the street (src/round.ts GRAB, from the hand on the side he faces): behind him, the ape, then the fan
// out in front, from the street up to over his head.
const SCOLS = 5, SROWS = 5, S_TOP = 3;
const streetCells: { cls: string; label: string }[] = [];
for (let r = 0; r < SROWS; r++) for (let c = 0; c < SCOLS; c++) {
  const dy = S_TOP - r, dx = c - 2;
  if (c === 1) streetCells.push(has(GRAB, NG, -1, dy) ? { cls: 'grab', label: 'grab' } : { cls: 'ape', label: dy === 0 ? 'APE ▸' : '' });
  else if (c === 0) streetCells.push({ cls: 'air', label: dy === 0 ? 'behind' : '' });
  else streetCells.push(has(GRAB, NG, dx, dy) ? { cls: 'grab', label: 'grab' } : { cls: 'air', label: '' });
}
const bricks = ['kernel', 'diorama', 'fx', 'input', 'pad', 'sound', 'touch', 'presence', 'ui'];
---
<Base title="CitySmash · climb it, smash it" description={description}>
  <section class="dt-hero" aria-labelledby="dt-title">
    <div class="dt-stage" id="dt-hero" aria-label="CitySmash demo: the ape smashing Port Lumen"></div>
    <a class="dt-poster" href={base('play/')} hidden><img src={base('shots/hero.jpg')} alt="CitySmash: a giant orange cyber ape hanging on a building's side, punching out its windows" width="1600" height="900" /></a>
    <div class="wrap dt-copy">
      <p class="eyebrow"><span class="dot"></span> A DOM VIRUS GAME · BY CHRIS COOLEY</p>
      <h1 id="dt-title">CitySmash.<br /><em>Climb it. Smash it. Eat the snacks.</em></h1>
      <p class="lead">You are a giant cyber ape. Seven tabletop cities, day into night. Hang on the walls, punch out the windows, bring the buildings down floor by floor. Then do it again with friends.</p>
      <div class="dt-ctas">
        <a class="bui-key bui-sticker-key bui-call start-key" href={base('play/')}><b>PLAY</b><span>free · in your browser</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <p class="eyebrow"><span class="index">01</span> HOW TO PLAY</p>
      <h2>Grip with one arm. Smash with the other.</h2>
      <ol class="cards">
        {steps.map(([k, b], i) => <li class="panel"><span class="n">0{i + 1}</span><h3>{k}</h3><p>{b}</p></li>)}
      </ol>
      <div class="reach" id="reach">
        <figure class="reach-fig">
          <figcaption><b>PUNCH: {NR} windows</b> on the building he holds</figcaption>
          <div class="reach-grid" role="img" aria-label={`Punch reach: ${NR} windows of his own building: close, mid and far on his floor, two up and two down.`}>
            {punchCells.map((x) => <span class={'rc ' + x.cls} data-cell={x.cls}>{x.label}</span>)}
          </div>
        </figure>
        <figure class="reach-fig">
          <figcaption><b>GRAB on a wall: the {NR} punch windows + {NGW - NR} more</b> from his free hand, never behind him</figcaption>
          <div class="reach-grid" role="img" aria-label={`Grab reach on a wall, from his free hand: the ${NR} punch windows (if he can punch it, he can grab it), the windows two floors up and down from them, and the air of the gap over his head and under his feet (${NGW} in all); helicopters in the ${NGH} nearest his hand. Nothing behind him or behind the building.`}>
            {grabCells.map((x) => <span class={'rc ' + x.cls} data-cell={x.cls}>{x.label}</span>)}
          </div>
        </figure>
        <figure class="reach-fig">
          <figcaption><b>GRAB on the street: {NG} spaces in front</b>, from the street to over his head (by his head too)</figcaption>
          <div class="reach-grid street" role="img" aria-label={`Grab reach on the street: ${NG} spaces in front of the hand on the side he faces, from the street up to over his head and in by his head; nothing behind him or under his body. Tap something behind him and he turns round first.`}>
            {streetCells.map((x) => <span class={'rc ' + x.cls} data-cell={x.cls}>{x.label}</span>)}
          </div>
        </figure>
        <ul class="reach-key">
          <li><span class="rc ape" aria-hidden="true"></span> the ape on the building's edge</li>
          <li><span class="rc bld" aria-hidden="true"></span> building</li>
          <li><span class="rc air" aria-hidden="true"></span> open air</li>
          <li><span class="rc punch" aria-hidden="true"></span> punch: his own building only</li>
          <li><span class="rc grab" aria-hidden="true"></span> grab: people, soldiers, food</li>
          <li><span class="rc heli" aria-hidden="true"></span> grab, and swat helicopters (by his hand)</li>
        </ul>
      </div>
      <p class="soon">Phone: the big fist punches, the hand grabs, the arrow jumps; on a wall flick the stick to move the target box a window, hold it to climb. Or tap what you want smashed or eaten. Computer, keys only or keys and the mouse: WASD or the arrows walk and climb, Space jumps (on a wall: a tap leaps to the next building, a double tap lets go), J punches the aimed window, K grabs, Q/E or Tab move the aim, or click what to smash or grab; M mutes. A gamepad: A jump, X punch, B grab, LB/RB aim. Each gamepad is a player of its own: press any button on the start menu to join.</p>
      <p class="soon"><a class="bui-key" href={base('play/?mode=practice')}>Try it in practice</a> Nothing hurts there: no army, no health lost, buildings come back. A card ticks off each move as you do it (walk, grab a wall, climb, all seven punches, a grab, a swat, a punch past a live window, a power punch and a pounce on a sparring dummy that never fights back).</p>
    </div>
  </section>

  <section class="section" id="cities">
    <div class="wrap">
      <p class="eyebrow"><span class="index">02</span> THE CITIES</p>
      <h2>Seven cities, each with a trick.</h2>
      <ol class="modes cities">
        {CITIES.map((c, i) => (
          <li class="panel">
            <span class="sky" style={`--s0:${c.sky};--s1:${c.walls[1]};--m:${c.mark}`} aria-hidden="true">{c.b.map(([w, f], b) => <i class={b === c.landmark ? 'mark' : ''} style={`height:${Math.round(f * 9)}%;flex:${w};--w:${c.walls[b % 5]}`}></i>)}</span>
            <p class="meta">{i + 1} · {TOD[c.tod]} · {c.featureName}</p>
            <h3>{c.name}</h3>
            <p>{c.blurb}</p>
            <p>{c.featureText}</p>
            <p class="meta">Landmark: {c.landmarkName}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="garage">
    <div class="wrap">
      <p class="eyebrow"><span class="index">03</span> THE GARAGE</p>
      <h2>Dress your ape. Earn the rest.</h2>
      <ul class="cards">
        <li class="panel"><h3>Fur and pattern</h3><p>Twelve fur colours; plain, stripes, patches, spots or a glowing circuit.</p></li>
        <li class="panel"><h3>Face</h3><p>A heavy brow, a crest, tusks, horns or a shaggy mane. Your ape's name comes from its fur and its face.</p></li>
        <li class="panel"><h3>Gear</h3><p>A cyber arm on the smashing arm, a visor, a chest plate, tail spikes, shoulder pads, a back reactor, knuckle spikes, a jaw guard. Eight neon trims.</p></li>
        <li class="panel"><h3>Hair</h3><p>A mohawk, spikes or a swept crest, in any of the neon colours.</p></li>
        <li class="panel"><h3>Unlocks and saves</h3><p>Every city you flatten unlocks new parts. One profile on this device, plus a save code to carry it to another.</p></li>
      </ul>
    </div>
  </section>

  <section class="section" id="monsters">
    <div class="wrap">
      <p class="eyebrow"><span class="index">04</span> THE MONSTERS</p>
      <h2>One ape. Three rivals. Beat them to play them.</h2>
      <ul class="modes mons">
        {mons.map(([n, w, b, k, what]) => <li class="panel"><canvas class="mon3d" data-kind={k} tabindex="0" role="img" aria-label={`${n}, ${what}: drag to turn`}></canvas><p class="meta">{w}</p><h3>{n}</h3><p>{b}</p></li>)}
      </ul>
      <p class="soon">Play as the ape from the start. Beat a rival in a city, playing alone, and it is yours to play too, in a colour and trim of your pick. The army fights back: soldiers on the street, snipers in the windows, helicopters, tanks, a gunboat. Out of health, a monster shrinks to a tiny figure and runs off the table.</p>
    </div>
  </section>

  <section class="section" id="online">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><span class="index">05</span> PLAY TOGETHER</p>
        <h2>Up to four, online. Gamepads for one screen.</h2>
        <p>One person a device: play with friends online, each on their own phone or computer. On one screen, extra players come with gamepads: each connected pad gets a slot on the start menu, a press joins it. Online: the host opens a room and sends the link; up to three friends drop in on their own phones or computers. The host is the ape, the others take the rivals. A shared score, and one score each. You can still punch each other off the walls.</p>
        <p>Online play needs an invite code.</p>
      </div>
      <div class="panel lit">
        <h3>Same run on every screen</h3>
        <p>Only the buttons travel. Every screen runs the same city frame for frame, and your own monster answers at once: if a friend's input arrives late, the game quietly rewinds a few frames and runs them again.</p>
      </div>
    </div>
  </section>

  <section class="section" id="fizlet">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><span class="index">06</span> BUILT ON FIZLET</p>
        <h2>No libraries. {kb} KB.</h2>
        <p>CitySmash is built on <a href="https://fizlet.com/">Fizlet</a>, the micro animation and game engine for the DOM, and nothing else: no framework, no 3D library, no images in the game. The cities, the giants and the army are drawn by Fizlet's bricks on one canvas.</p>
        <p>The whole game, its Fizlet bricks and its Board UI styles: <b>{GZIP.toLocaleString('en-US')} bytes gzip</b> (measured at build, Fizlet {FIZLET}).</p>
        <ul class="bricks">{bricks.map((b) => <li><code>@fzlt/core/{b}</code></li>)}</ul>
      </div>
      <div class="panel lit by">
        <p class="eyebrow"><b>BY CHRIS COOLEY</b></p>
        <h3>It started as a tiny daily.</h3>
        <p>CitySmash grew out of a piece in Fizlet's Daily: one ape, one city block. It kept the climb and the punch, and got seven cities, a garage and friends.</p>
        <p><a href="https://coded.design/">coded.design</a> · <a href={REPO}>Source on GitHub (MIT)</a></p>
        <a class="bui-key bui-arcade bui-go" href={base('play/')}>▶ Play CitySmash</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createCitySmash, turntable, LOOK0 } from "../../../dist/citysmash.mjs";
  const host = document.getElementById("dt-hero")!;
  const poster = document.querySelector<HTMLElement>(".dt-poster")!;
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) poster.hidden = false;
  else (window as unknown as { hero: unknown }).hero = createCitySmash({ host, attract: true, sound: false });

  // The monsters, each on the game's own turntable: started only when its card scrolls into view, paused
  // off-screen; a slow spin (none with reduced motion: a still pose); drag or swipe sideways to turn it
  // (touch-action pan-y: the page still scrolls), or the arrow keys.
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const theme = () => (document.documentElement.dataset.theme === "light" ? "light" : "dark") as "light" | "dark";
  type Card = { cv: HTMLCanvasElement; kind: number; tt: ReturnType<typeof turntable> | null; turn: number; seen: boolean; drag: number };
  const cardsEl = [...document.querySelectorAll<HTMLCanvasElement>("canvas.mon3d")].map((cv, i): Card => ({ cv, kind: +cv.dataset.kind!, tt: null, turn: -0.6 + i * 0.35, seen: false, drag: -1 }));
  let raf = 0, last = 0;
  const draw = (c: Card) => {
    c.tt ??= turntable(c.cv, theme);
    c.tt.draw(c.kind, LOOK0, null, c.turn, performance.now() / 1000);
    c.cv.dataset.drawn = "1";
  };
  const loop = (t: number) => {
    const dt = Math.min(0.05, (t - last) / 1000 || 0);
    last = t;
    raf = 0;
    let any = false;
    for (const c of cardsEl) if (c.seen) (any = true), c.drag < 0 && !calm && (c.turn += dt * 0.5), draw(c);
    if (any && !calm) raf = requestAnimationFrame(loop);
  };
  const wake = () => void (raf || calm || (raf = requestAnimationFrame(loop)));
  const io = new IntersectionObserver((es) => {
    for (const e of es) {
      const c = cardsEl.find((c) => c.cv === e.target)!;
      c.seen = e.isIntersecting;
      if (c.seen) draw(c);
    }
    wake();
  }, { rootMargin: "120px 0px" });
  for (const c of cardsEl) {
    io.observe(c.cv);
    c.cv.addEventListener("pointerdown", (e) => ((c.drag = e.clientX), c.cv.setPointerCapture?.(e.pointerId)));
    c.cv.addEventListener("pointermove", (e) => {
      if (c.drag < 0) return;
      c.turn += (e.clientX - c.drag) * 0.012;
      c.drag = e.clientX;
      draw(c);
    });
    const up = () => void ((c.drag = -1), wake());
    c.cv.addEventListener("pointerup", up);
    c.cv.addEventListener("pointercancel", up);
    c.cv.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      e.preventDefault();
      c.turn += e.key === "ArrowLeft" ? -0.3 : 0.3;
      draw(c);
    });
  }
  new ResizeObserver(() => cardsEl.forEach((c) => c.seen && c.tt && (c.tt.invalidate(), draw(c)))).observe(document.querySelector(".mons")!);
  new MutationObserver(() => cardsEl.forEach((c) => c.seen && draw(c))).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  (window as unknown as { mons: unknown }).mons = cardsEl;
</script>
